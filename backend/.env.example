ZHIXING_ENVIRONMENT=development
ZHIXING_DATABASE_URL=sqlite:///./.data/zhixing.db
ZHIXING_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ZHIXING_SESSION_TTL_HOURS=8
ZHIXING_ASSET_ROOT=./.data/assets
ZHIXING_ASSET_MAX_BYTES=20971520
ZHIXING_MODEL_CONNECT_TIMEOUT_SECONDS=10
ZHIXING_MODEL_READ_TIMEOUT_SECONDS=180
ZHIXING_MODEL_MAX_ATTEMPTS=2

# 填入自己的官方服务凭据。数据区域与保留策略由部署者按账号规则核验后启用。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL_ID=deepseek-flash
DEEPSEEK_PRO_MODEL_ID=deepseek-v4-pro
DEEPSEEK_THINKING_MODE=disabled
# 兼容旧Flash配置 DEEPSEEK_MODEL_ID；优先使用DEEPSEEK_FLASH_MODEL_ID。
# ZHIXING_MODEL_ALLOWED_DATA_REGIONS=deployment_configured
# ZHIXING_MODEL_ALLOWED_RETENTION_POLICIES=provider_account_policy
