ZHIXING_ENVIRONMENT=development
ZHIXING_DATABASE_URL=sqlite:///./.data/zhixing.db
ZHIXING_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4174
ZHIXING_SESSION_TTL_HOURS=8
ZHIXING_ASSET_ROOT=./.data/assets
ZHIXING_ASSET_MAX_BYTES=20971520
ZHIXING_MODEL_CONNECT_TIMEOUT_SECONDS=5
ZHIXING_MODEL_READ_TIMEOUT_SECONDS=45
ZHIXING_MODEL_MAX_ATTEMPTS=2
# 仅填写已经由部署方核验并允许的策略枚举；未配置时所有外部模型均不可行。
# ZHIXING_MODEL_ALLOWED_DATA_REGIONS=deployment_configured
# ZHIXING_MODEL_ALLOWED_RETENTION_POLICIES=provider_account_policy
# ZHIXING_FACT_SOURCE=./config/project_facts.yaml

# 模型Profile只在数据库保存以下环境变量名；真实值仅由运行环境注入。
# 不要把真实密钥写入本文件、源码、文档、终端历史或日志；已在聊天等位置暴露的凭证必须先轮换。
# DeepSeek Profile使用部署者明确批准的OpenAI兼容端点。密钥只能由运行环境注入；
# 兼容层只解包唯一且可解析的JSON对象，仍会拒绝数组、多对象和多代码块。
# 数据区域和保留策略未经部署方核验时，应保持Profile不可用。
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# OPENAI_MODEL_ID=
# DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_ID=deepseek-flash
DEEPSEEK_THINKING_MODE=disabled
# QWEN_API_KEY=
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL_ID=
# GLM_API_KEY=
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL_ID=
